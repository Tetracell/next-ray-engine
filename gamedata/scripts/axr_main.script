-- Kutez: Callback Priority System (https://github.com/themrdemonized/xray-monolith/pull/339)
--
-- before_funcs / after_funcs are stored as persistent ordering constraints.
-- This makes callback ordering independent of script registration order:
--   callback_set(name, A, { B }, {}) => A runs before B
--   callback_set(name, A, {}, { B }) => A runs after B
-- Function constraints may reference callbacks which have not been registered yet;
-- they become active automatically when those functions are later registered.
-- References to userdata are scrubbed when that userdata is unregistered.
local next_index = {}
local callback_order = {}
local callback_constraints = {}

for name,v in pairs(intercepts) do
	next_index[name] = 1
	callback_order[name] = {}
	callback_constraints[name] = {}
end

local function callback_priority_name(priority)
	if priority == CALLBACKS_PRE then
		return "PRE"
	elseif priority == CALLBACKS_NORMAL then
		return "NORMAL"
	elseif priority == CALLBACKS_POST then
		return "POST"
	end
	return tostring(priority)
end

local function callback_valid_priority(priority)
	return priority == CALLBACKS_PRE
		or priority == CALLBACKS_NORMAL
		or priority == CALLBACKS_POST
end

-- Normalize a single callback or a callback array into a private table.
-- Keeping a private copy prevents callers from mutating constraints after registration.
local function callback_normalize_constraint_list(targets, argument_name)
	if not targets then
		return {}
	end

	local target_type = type(targets)
	if target_type == "function" or target_type == "userdata" then
		return {targets}
	end

	if target_type ~= "table" then
		return nil, string.format("%s must be a function, userdata, table, or nil", argument_name)
	end

	local result = {}
	for k, target in pairs(targets) do
		local value_type = type(target)
		if value_type ~= "function" and value_type ~= "userdata" then
			return nil, string.format("%s contains unsupported value of type %s", argument_name, value_type)
		end
		result[k] = target
	end
	return result
end

-- Remove references to a callback identity from a constraint list.
local function callback_remove_constraint_target(targets, target)
	local remove_keys = {}
	for k, value in pairs(targets) do
		if value == target then
			remove_keys[#remove_keys + 1] = k
		end
	end
	for i = 1, #remove_keys do
		targets[remove_keys[i]] = nil
	end
end

-- Recompute numeric priorities used by make_callback().
-- PRE, NORMAL and POST are hard tiers. Explicit before/after constraints can
-- order callbacks inside a tier, while compatible cross-tier constraints are
-- already implied by the tier order. Contradictory cross-tier constraints and
-- dependency cycles are rejected instead of being silently broken.
--
-- This function is transactional: callback priorities are only written after
-- the complete proposed ordering has been validated successfully.
-- Each callback's functions in call order, kept until a function is set or unset: make_callback sorted them
-- on every call. callback_order_cache = false sorts on every call again (for comparing).
callback_order_cache = true
local callback_list = {} -- name -> its functions in call order (neXt-Ray cache)

local function ordered_callbacks(name)
	local list = callback_order_cache and callback_list[name]
	if not list then
		list = {}
		for func_or_userdata in spairs(intercepts[name], sort_func_values_ascend) do
			list[#list + 1] = func_or_userdata
		end
		callback_list[name] = list
	end
	return list
end

local function callback_reorder(name)
	callback_list[name] = nil
	local callbacks = intercepts[name]
	if not callbacks then
		return true
	end

	local order = callback_order[name]
	local constraints = callback_constraints[name]
	local edges = {}
	local indegree = {}
	local tier_members = {
		[CALLBACKS_PRE] = {},
		[CALLBACKS_NORMAL] = {},
		[CALLBACKS_POST] = {}
	}

	for func_or_userdata in pairs(callbacks) do
		local rule = constraints[func_or_userdata]
		if not rule then
		    rule = {
		        priority = CALLBACKS_NORMAL,
		        before = {},
		        after = {}
		    }
		    constraints[func_or_userdata] = rule
		else
		    if not rule.priority then
		        rule.priority = CALLBACKS_NORMAL
		    end

		    if not rule.before then
		        rule.before = {}
		    end

		    if not rule.after then
		        rule.after = {}
		    end
		end
		if not callback_valid_priority(rule.priority) then
			return false, string.format("callback has invalid tier %s", tostring(rule.priority))
		end

		if not order[func_or_userdata] then
			order[func_or_userdata] = next_index[name]
			next_index[name] = next_index[name] + 1
		end

		edges[func_or_userdata] = {}
		indegree[func_or_userdata] = 0
		tier_members[rule.priority][func_or_userdata] = true
	end

	local function add_same_tier_edge(from_func, to_func)
		if from_func == to_func then
			return false, string.format("callback depends on itself")
		end
		if not edges[from_func][to_func] then
			edges[from_func][to_func] = true
			indegree[to_func] = indegree[to_func] + 1
		end
		return true
	end

	-- Validate every active constraint and build edges only for callbacks in the
	-- same tier. Missing targets remain valid forward references and become active
	-- automatically if that exact function is registered later. References to
	-- unregistered userdata are removed by callback_unset().
	for func_or_userdata, rule in pairs(constraints) do
		if callbacks[func_or_userdata] ~= nil then
			for k, target in pairs(rule.before) do
				if callbacks[target] ~= nil then
					local target_rule = constraints[target]
					if not target_rule then
						return false, string.format("target callback has no constraint metadata")
					end

					if rule.priority > target_rule.priority then
						return false, string.format(
							"%s callback cannot run before %s callback",
							callback_priority_name(rule.priority),
							callback_priority_name(target_rule.priority)
						)
					elseif rule.priority == target_rule.priority then
						local ok, err = add_same_tier_edge(func_or_userdata, target)
						if not ok then
							return false, err
						end
					end
				end
			end

			for k, target in pairs(rule.after) do
				if callbacks[target] ~= nil then
					local target_rule = constraints[target]
					if not target_rule then
						return false, string.format("target callback has no constraint metadata")
					end

					if rule.priority < target_rule.priority then
						return false, string.format(
							"%s callback cannot run after %s callback",
							callback_priority_name(rule.priority),
							callback_priority_name(target_rule.priority)
						)
					elseif rule.priority == target_rule.priority then
						local ok, err = add_same_tier_edge(target, func_or_userdata)
						if not ok then
							return false, err
						end
					end
				end
			end
		end
	end

	local proposed_order = {}
	local tiers = {CALLBACKS_PRE, CALLBACKS_NORMAL, CALLBACKS_POST}

	-- Stable topological sort each hard tier independently. When several callbacks
	-- are available, preserve their original registration order.
	for i = 1, #tiers do
		local tier = tiers[i]
		local remaining = {}
		local remaining_count = 0

		for func_or_userdata in pairs(tier_members[tier]) do
			remaining[func_or_userdata] = true
			remaining_count = remaining_count + 1
		end

		while remaining_count > 0 do
			local selected = nil
			local selected_order = nil

			for func_or_userdata, exists in pairs(remaining) do
				if exists and indegree[func_or_userdata] == 0 then
					local registration_order = order[func_or_userdata] or 0
					if not selected or registration_order < selected_order then
						selected = func_or_userdata
						selected_order = registration_order
					end
				end
			end

			if not selected then
				return false, string.format(
					"dependency cycle detected in callback %s (%s tier)",
					name, callback_priority_name(tier)
				)
			end

			proposed_order[#proposed_order + 1] = selected
			remaining[selected] = nil
			remaining_count = remaining_count - 1

			for target in pairs(edges[selected]) do
				if remaining[target] then
					indegree[target] = indegree[target] - 1
				end
			end
		end
	end

	-- Commit only after the entire graph has been proven valid.
	for priority = 1, #proposed_order do
		callbacks[proposed_order[priority]] = priority
	end
	return true
end

-----------------------------------------------------------
-- Global Callback Register
-- param 1 - name as type<string> (ie. intercepts[name])
-- param 2 - function to execute as type<function> or userdata with name as function
-- param 3 - optional callback/array this callback must run before
-- param 4 - optional callback/array this callback must run after
-- param 5 - optional tier: CALLBACKS_PRE / CALLBACKS_NORMAL / CALLBACKS_POST
-----------------------------------------------------------
function callback_add(name)
	callback_list[name] = nil
	if (not intercepts[name]) then
		intercepts[name] = {}
		next_index[name] = 1
		callback_order[name] = {}
		callback_constraints[name] = {}
	else
		printf("![axr_main callback_add] callback %s already exists!",name)
		callstack()
	end
end

function callback_set(name, func_or_userdata, before_funcs, after_funcs, priority)
	if not func_or_userdata then 
		printf("![axr_main callback_set] trying to set callback %s to nil function!",name)
		callstack()
		return
	end
	callback_list[name] = nil
	if not intercepts[name] then
		printf("![axr_main callback_set] callback %s doesn't exist!",name)
		callstack()
		return
	end

	local normalized_before, before_error = callback_normalize_constraint_list(before_funcs, "before_funcs")
	if not normalized_before then
		assert(false, string.format("![axr_main callback_set] rejected callback dependency for %s: %s", name, before_error))
		callstack()
	end

	local normalized_after, after_error = callback_normalize_constraint_list(after_funcs, "after_funcs")
	if not normalized_after then
		assert(false, string.format("![axr_main callback_set] rejected callback dependency for %s: %s", name, after_error))
		callstack()
	end

	if not priority then
		priority = CALLBACKS_NORMAL
	end
	if not callback_valid_priority(priority) then
		assert(false, string.format("![axr_main callback_set] rejected callback dependency for %s: invalid callback tier %s", name, tostring(priority)))
		callstack()
	end

	-- Registration order is stable: re-registering the same function/userdata
	-- replaces its constraints/tier without moving its fallback position.
	local old_next_index = next_index[name]
	local old_order = callback_order[name][func_or_userdata]
	local old_constraint = callback_constraints[name][func_or_userdata]
	local old_priority = intercepts[name][func_or_userdata]
	local was_registered = old_priority ~= nil

	if not old_order then
		callback_order[name][func_or_userdata] = next_index[name]
		next_index[name] = next_index[name] + 1
	end

	callback_constraints[name][func_or_userdata] = {
		priority = priority,
		before = normalized_before,
		after = normalized_after
	}

	-- New callbacks need to be visible to callback_reorder(). Existing callbacks
	-- keep their old numeric priority until the proposed graph is validated.
	if not was_registered then
		intercepts[name][func_or_userdata] = callback_order[name][func_or_userdata]
	end

	local ok, reorder_error = callback_reorder(name)
	if not ok then
		-- Roll back the attempted registration completely. callback_reorder() does
		-- not commit partial priorities, so the previous valid order is preserved.
		next_index[name] = old_next_index
		callback_order[name][func_or_userdata] = old_order
		callback_constraints[name][func_or_userdata] = old_constraint
		intercepts[name][func_or_userdata] = old_priority

		printf("![axr_main callback_set] rejected callback for %s: %s", tostring(func_or_userdata), name, reorder_error)
		callstack()
	end
end

function callback_unset(name,func_or_userdata)
	callback_list[name] = nil
	if (intercepts[name]) then
		intercepts[name][func_or_userdata] = nil
		callback_order[name][func_or_userdata] = nil
		callback_constraints[name][func_or_userdata] = nil

		-- Functions may be intentionally referenced while unregistered so they can
		-- be registered again later and reactivate forward constraints. LuaBind
		-- userdata is different: remove references to it so stale binder instances
		-- are not kept alive solely by another callback's constraint table.
		if type(func_or_userdata) == "userdata" then
			for other_callback, rule in pairs(callback_constraints[name]) do
				callback_remove_constraint_target(rule.before, func_or_userdata)
				callback_remove_constraint_target(rule.after, func_or_userdata)
			end
		end

		local ok, reorder_error = callback_reorder(name)
		if not ok then
			printf("![axr_main callback_unset] failed to reorder callback %s after unregistering %s: %s", name, tostring(func_or_userdata), reorder_error)
			callstack()
		end
	else
		printf("![axr_main callback_unset] callback %s doesn't exist!",name)
		callstack()
	end
end

-----------------------------------------------------------
-- Callback profiler: lua_profile_start(seconds), e.g. "run_string axr_main.lua_profile_start(5)" (needs -dbg).
-- Times every function make_callback calls, per callback and per function (script file and line), and the
-- dispatch around them, then writes the per frame averages to the log. Off, it costs one check per callback.
-----------------------------------------------------------
local prof = nil
local sample_first_update = nil

local function prof_timer(tbl, key)
	local t = tbl[key]
	if not t then
		t = { timer = profile_timer(), calls = 0 }
		tbl[key] = t
	end
	t.calls = t.calls + 1
	return t.timer
end

local function prof_key(P, name, f)
	local key = P.keys[f]
	if not key then
		local info = debug and debug.getinfo and debug.getinfo(f, "S")
		key = name .. "  " .. (info and (tostring(info.short_src) .. ":" .. tostring(info.linedefined)) or tostring(f))
		P.keys[f] = key
	end
	return key
end

local function prof_report()
	local measured = math.max(1, device().frame - prof.start_frame)
	-- A load (end_frame): totals, else averages per frame
	local frames = prof.end_frame and 1 or measured
	local function sorted(tbl)
		local list = {}
		for key, t in pairs(tbl) do
			list[#list + 1] = { key = key, us = t.timer:time(), calls = t.calls }
		end
		table.sort(list, function(a, b) return a.us > b.us end)
		return list
	end
	if prof.end_frame then
		log(string.format("* [Lua callbacks] totals over the load and its first %d frames (ms incl. nested callbacks, calls)", measured))
	else
		log(string.format("* [Lua callbacks] average per frame over %d frames (ms incl. nested callbacks, calls)", frames))
	end
	-- Time in the callbacks' functions, per callback: the rest of a callback's time is its dispatch
	local in_funcs = {}
	for key, t in pairs(prof.funcs) do
		local name = string.match(key, "^(%S+)")
		in_funcs[name] = (in_funcs[name] or 0) + t.timer:time()
	end
	log(string.format("*   by callback: total, calls, of it dispatch (sorting, calls)"))
	for i, e in ipairs(sorted(prof.totals)) do
		if i > 25 then break end
		log(string.format("*     %-60s %7.3f %7.1f %7.3f", e.key, e.us / 1000 / frames, e.calls / frames, (e.us - (in_funcs[e.key] or 0)) / 1000 / frames))
	end
	log(string.format("*   by function:"))
	for i, e in ipairs(sorted(prof.funcs)) do
		if i > 60 or e.us / 1000 / frames < 0.01 then break end
		log(string.format("*     %-60s %7.3f %7.1f", e.key, e.us / 1000 / frames, e.calls / frames))
	end
	prof = nil
	get_console():execute("flush")
end

function lua_profile_start(seconds)
	prof = { totals = {}, funcs = {}, keys = {}, start_frame = device().frame, end_time = time_global() + (seconds or 5) * 1000 }
	log(string.format("* [Lua callbacks] measuring for %d s...", seconds or 5))
end

-- From a level load on, for its first frames (the precache frames behind the loading screen and a few more): totals.
-- Counted in frames, time_global() doesn't move while loading
function lua_profile_load(frames)
	prof = { totals = {}, funcs = {}, keys = {}, start_frame = device().frame, end_frame = device().frame + (frames or 120) }
	log(string.format("* [Lua callbacks] measuring the load and its first %d frames...", frames or 120))
end

local function make_callback_profiled(name, ...)
	-- This capture's tables, also when a nested callback ends it
	local P = prof
	local total = prof_timer(P.totals, name)
	total:start()
	local list = ordered_callbacks(name)
	for i = 1, #list do
		local func_or_userdata = list[i]
		local f = func_or_userdata
		if (type(func_or_userdata) ~= "function") then
			f = func_or_userdata[name]
		end
		if f then
			local t = prof_timer(P.funcs, prof_key(P, name, f))
			t:start()
			if (f == func_or_userdata) then
				f(...)
			else
				f(func_or_userdata, ...)
			end
			t:stop()
		end
	end
	total:stop()
	if (prof and (prof.end_frame and device().frame >= prof.end_frame or not prof.end_frame and time_global() >= prof.end_time)) then
		prof_report()
	end
end

-- Where Lua code spends its time, by source line and function: sampled every 1000 Lua instructions, the time since
-- the last sample counted for the current place (time in engine functions goes to the line that called them)
function sampler_start()
	local sampler = { lines = {}, funcs = {}, clock = profile_timer(), last = 0 }
	sampler.clock:start()
	debug.sethook(function()
		sampler.clock:stop()
		local now = sampler.clock:time()
		sampler.clock:start()
		local dt = now - sampler.last
		sampler.last = now
		local info = debug.getinfo(2, "Sln")
		if info then
			local line = info.short_src .. ":" .. tostring(info.currentline)
			local func = info.short_src .. ":" .. tostring(info.linedefined) .. " " .. tostring(info.name)
			sampler.lines[line] = (sampler.lines[line] or 0) + dt
			sampler.funcs[func] = (sampler.funcs[func] or 0) + dt
		end
	end, "", 1000)
	return sampler
end

function sampler_report(sampler, title)
	debug.sethook()
	local function top(tbl, what)
		local list = {}
		for k, v in pairs(tbl) do list[#list + 1] = { k = k, v = v } end
		table.sort(list, function(a, b) return a.v > b.v end)
		log(string.format("* [axr_main] %s, %s:", title, what))
		for i = 1, math.min(30, #list) do
			log(string.format("*   %8.1f ms  %s", list[i].v / 1000, list[i].k))
		end
	end
	top(sampler.funcs, "by function")
	top(sampler.lines, "by line")
end

-----------------------------------------------------------
-- Mod cost overlay (perf_overlay_mods 1): while it is on, the time of every function the callbacks and the time events
-- call, by the Mod Organizer 2 mod its script comes from (mod_of_script), sent to the overlay once a second: average
-- per frame, the slowest frame, calls per frame. A nested callback's time counts for its own functions only; time
-- events made while it is on are timed for the function they run (not the time event script's update)
-----------------------------------------------------------
local mc = nil
local mc_mods = {} -- script -> the name shown
local mc_wrapped = {} -- module -> its CreateTimeEvent before

local function mc_script(f)
	local s = mc.scripts[f]
	if not s then
		local info = debug and debug.getinfo and debug.getinfo(f, "S")
		local src = info and tostring(info.short_src) or "?"
		s = string.match(src, "([^\\/]+)%.script") or src
		mc.scripts[f] = s
	end
	return s
end

-- The engine's microsecond clock, a plain C function (cheap: it runs twice per callback function)
local mc_clock = profile_clock_us or function() return time_global_async() * 1000 end

-- The clock goes to the script running (nil: the dispatch); returns the one before
local function mc_switch(owner)
	local t = mc_clock()
	local prev = mc.owner
	if prev then
		mc.frame[prev] = (mc.frame[prev] or 0) + (t - mc.last)
	end
	mc.last = t
	mc.owner = owner
	return prev
end

local function mc_enter(f)
	local s = mc_script(f)
	mc.calls[s] = (mc.calls[s] or 0) + 1
	return mc_switch(s)
end

local function mc_leave(prev, ...)
	if mc then
		mc_switch(prev)
	end
	return ...
end

local function mc_wrap_time_events(module)
	if not (module and module.CreateTimeEvent) or mc_wrapped[module] then
		return
	end
	local create = module.CreateTimeEvent
	mc_wrapped[module] = create
	module.CreateTimeEvent = function(ev_id, act_id, timer, f, ...)
		if not (mc and type(f) == "function") then
			return create(ev_id, act_id, timer, f, ...)
		end
		local function timed(...)
			if not mc then
				return f(...)
			end
			return mc_leave(mc_enter(f), f(...))
		end
		mc.scripts[timed] = mc_script(f)
		return create(ev_id, act_id, timer, timed, ...)
	end
end

local function mc_name(script)
	local name = mc_mods[script]
	if not name then
		name = mod_of_script and mod_of_script(script) or ""
		if name == "" then
			name = script .. ".script"
		end
		mc_mods[script] = name
	end
	return name
end

local function mc_publish()
	local frames = math.max(1, mc.frames)
	local list, total = {}, 0
	for name, us in pairs(mc.sum) do
		list[#list + 1] = { name = name, us = us }
		total = total + us
	end
	table.sort(list, function(a, b) return a.us > b.us end)
	local lines = {}
	for i = 1, math.min(#list, 12) do
		local e = list[i]
		lines[i] = string.format("%s\t%.3f\t%.3f\t%.1f", e.name, e.us / 1000 / frames, (mc.peak[e.name] or 0) / 1000,
			(mc.mod_calls[e.name] or 0) / frames)
	end
	perf_mod_cost(table.concat(lines, "\n"), total / 1000 / frames, frames)
	mc.sum, mc.peak, mc.mod_calls, mc.frames = {}, {}, {}, 0
end

-- Once a frame (actor_on_update): on or off as the overlay is, the frame's times added up by mod
local function mc_frame()
	local on = get_console():get_integer("perf_overlay_mods") ~= 0
	if on and not mc then
		mc = { last = mc_clock(), owner = nil, scripts = {}, calls = {}, frame = {}, sum = {}, peak = {},
			mod_calls = {}, frames = 0, publish_at = time_global_async() + 1000 }
		mc_wrap_time_events(_G)
		mc_wrap_time_events(demonized_time_events)
	elseif not on and mc then
		perf_mod_cost("", 0, 0)
		mc = nil
	end
	if not mc then
		return
	end
	mc_switch(nil)
	local by_mod = {}
	for script, us in pairs(mc.frame) do
		if us > 0 then
			local name = mc_name(script)
			by_mod[name] = (by_mod[name] or 0) + us
			mc.frame[script] = 0
		end
	end
	for script, n in pairs(mc.calls) do
		local name = mc_name(script)
		mc.mod_calls[name] = (mc.mod_calls[name] or 0) + n
	end
	mc.calls = {}
	for name, us in pairs(by_mod) do
		mc.sum[name] = (mc.sum[name] or 0) + us
		if us > (mc.peak[name] or 0) then
			mc.peak[name] = us
		end
	end
	mc.frames = mc.frames + 1
	local now = time_global_async()
	if now >= mc.publish_at then
		mc.publish_at = now + 1000
		mc_publish()
	end
end

local function make_callback_measured(name, ...)
	local list = ordered_callbacks(name)
	for i = 1, #list do
		local func_or_userdata = list[i]
		local f = func_or_userdata
		if (type(func_or_userdata) ~= "function") then
			f = func_or_userdata[name]
		end
		if f then
			local prev = mc_enter(f)
			if (f == func_or_userdata) then
				f(...)
			else
				f(func_or_userdata, ...)
			end
			if mc then
				mc_switch(prev)
			end
		end
	end
end

function make_callback(name,...)
	if (sample_first_update and name == "actor_on_first_update") then
		sample_first_update = nil
		local sampler = sampler_start()
		make_callback(name, ...)
		sampler_report(sampler, "actor_on_first_update profile")
		return
	end
	if (name == "actor_on_update") then
		mc_frame()
	end
	if (prof and intercepts[name]) then
		return make_callback_profiled(name, ...)
	end
	if (mc and intercepts[name]) then
		return make_callback_measured(name, ...)
	end
	if (intercepts[name]) then
		-- The list, not the table: a function set or unset meanwhile doesn't change this call's list (as spairs)
		local list = ordered_callbacks(name)
		for i = 1, #list do
			local func_or_userdata = list[i]
			if (type(func_or_userdata) == "function") then 
				func_or_userdata(...)
			elseif (func_or_userdata[name]) then
				func_or_userdata[name](func_or_userdata,...)
			end
		end
	else
		printf("![axr_main make_callback] can't make callback to non existing intercept %s!",name)
		callstack()
	end
end

--------------------------------------------------------------------------------------------------------------------
-- ON GAME START
--------------------------------------------------------------------------------------------------------------------
function on_game_start()
	local ignore = { 
		["_G.script"] = true,
		["class_registrator.script"] = true,
		["game_registrator.script"] = true,
		["ui_registrator.script"] = true,
		["ce_new_attachable_item.script"] = true,
		["ce_new_game_dm.script"] = true,
		["sim_faction_brain_human.script"] = true,
		["sim_faction_brain_mutant.script"] = true,
		["ce_switcher.script"] = true,
		["axr_main.script"] = true,
		["lua_help.script"] = true,
		["rx_gl.script"] = true
	}
	
	local t = {}
	local size_t = 0 
	local f	= getFS()
	local flist = f:file_list_open_ex("$game_scripts$",bit_or(FS.FS_ListFiles,FS.FS_RootOnly),"*.script")
	local f_cnt = flist:Size()
	-- Load time on every level load (it runs all scripts again): loading them, then each one's on_game_start
	local load_timer = profile_timer()
	load_timer:start()
	-- With the file appdata\lua_load_profile present: where loading the scripts spends its time, by source line
	-- and function (sampled every 1000 Lua instructions, the time since the last sample counted for the current place)
	local sampler = nil
	-- Read from disk: the file list of getFS() is from the game's start
	local marker = io.open(f:update_path("$app_data_root$", "lua_load_profile"), "r")
	if marker then marker:close() end
	-- appdata\lua_callback_profile: the callbacks of this load and its first frames (lua_profile_load)
	local cb_marker = io.open(f:update_path("$app_data_root$", "lua_callback_profile"), "r")
	if cb_marker then
		cb_marker:close()
		lua_profile_load(120)
		-- and actor_on_first_update by source line
		sample_first_update = debug and debug.sethook and true
	end
	if (marker and debug and debug.sethook) then
		sampler = sampler_start()
	end
	for	it=0, f_cnt-1 do
		local file = flist:GetAt(it)
		local file_name = file:NameShort()
		--printf("%s size=%s",file_name,file:Size())
		if (file:Size() > 0 and ignore[file_name] ~= true) then
			file_name = file_name:sub(0,file_name:len()-7)
			local script = _G[file_name]
			-- That ran _g.script again (as the namespace _g): its ini readers through the engine from here (_g_patches)
			if (file_name == "_g" and native_g_ini_readers) then
				native_g_ini_readers()
			end
			if (script and script.on_game_start) then
				size_t = size_t + 1 
				t[size_t] = file_name -- load all scripts first
			end
		end
	end
	load_timer:stop()
	if sampler then
		sampler_report(sampler, "load profile")
	end
	local start_timers = {}
	local start_total = profile_timer()
	start_total:start()
	for i=1,#t do
		--printf("%s.on_game_start()",t[i])
		local timer = profile_timer()
		timer:start()
		_G[ t[i] ].on_game_start()
		timer:stop()
		start_timers[#start_timers + 1] = { name = t[i], us = timer:time() }
	end
	start_total:stop()
	table.sort(start_timers, function(a, b) return a.us > b.us end)
	local top = {}
	for i = 1, math.min(8, #start_timers) do
		top[#top + 1] = string.format("%s %.0f", start_timers[i].name, start_timers[i].us / 1000)
	end
	log(string.format("* [axr_main] scripts loaded in %.0f ms, %d on_game_start in %.0f ms, slowest (ms): %s",
		load_timer:time() / 1000, #t, start_total:time() / 1000, table.concat(top, ", ")))
end

------------------
-- main_menu_on_init()
------------------
function main_menu_on_init(menu)
	xrs_dyn_music.main_menu_on(menu)
end

------------------
-- main_menu_on_quit()
------------------
function main_menu_on_quit(menu)
	xrs_dyn_music.main_menu_off(menu)
end

function actor_on_weapon_zoom_in()
	local wpn = db.actor:active_item()
	
	scoped_weapon_is_zoomed = wpn and IsWeapon(wpn) and wpn:weapon_is_scope()
	binoc_is_zoomed = wpn and (wpn:section() == "wpn_binoc_inv")
	weapon_is_zoomed = true
	
	SendScriptCallback("GUI_on_show", "UIZoom") -- to force hiding HUD UIs on Zooming
end 

function actor_on_weapon_zoom_out()
	scoped_weapon_is_zoomed = false
	binoc_is_zoomed = false
	weapon_is_zoomed = false
	SendScriptCallback("GUI_on_hide", "UIZoom") -- to force hiding HUD UIs on Zooming
end

------------------
-- server_entity_on_register
------------------
function server_entity_on_register(se_obj,type_name)
	local id = se_obj.id
	if (id == AC_ID) then
		story_objects.register(id,"actor")
	else
		story_objects.check_spawn_ini_for_story_id(se_obj)
	end
end

------------------
-- server_entity_on_unregister
------------------
-- good place to remove ids from persistent tables
function server_entity_on_unregister(se_obj,type_name)
	local id = se_obj.id
	local m_data = alife_storage_manager.get_state()
	if (m_data) then 
		if (m_data.se_object) then
			m_data.se_object[id] = nil
			--printf("$ alife_storage | cleaning server object [%s](%s) mdata", se_obj:name(), id)
		end
		if (m_data.game_object) then
			m_data.game_object[id] = nil
			--printf("$ alife_storage | cleaning game object [%s](%s) mdata", se_obj:name(), id)
		end
	end
	story_objects.unregister(id)
end