--- Options menu extension

-- Steam Deck preset: lowers the settings whose loss is hard to see on the Deck's 800p screen. Turning it on
-- remembers the current values (axr_options, section deck_preset) and turning it off restores them, so the
-- two can be compared. Each entry only ever lowers a setting (values already lower are left alone), except the Lua
-- GC mode, which only ever goes up. With nothing remembered (the options file replaced while the preset was on), turning
-- it off sets the engine's default.
--   index: position in a vector setting (1-based), nil for a plain value
--   value: the preset value; mode "max" keeps the larger of current and preset (resolution divisors),
--          "min" the smaller (sample counts, distances, quality scales)
--   default: GAMMA's value of it (the engine's default where GAMMA leaves it)
local deck_preset = {
	{ cmd = "ssfx_ao",              index = 1, value = 2,    mode = "max", default = 1 }, -- ambient occlusion at half resolution
	{ cmd = "ssfx_ssr",             index = 1, value = 2,    mode = "max", default = 1 }, -- screen space reflections at half resolution
	{ cmd = "ssfx_sss_quality",     index = 1, value = 8,    mode = "min", default = 12 }, -- screen space sun shadow samples
	{ cmd = "ssfx_sss_quality",     index = 2, value = 3,    mode = "min", default = 4 }, -- screen space shadow samples, other lights
	{ cmd = "ssfx_shadow_cascades", index = 3, value = 140,  mode = "min", default = 160 }, -- far sun shadow cascade, metres
	{ cmd = "r2_ls_squality",                  value = 0.75, mode = "min", default = 1 }, -- point and spot light shadow map size
	{ cmd = "r4_sun_smap_scale",    index = 1, value = 0.75, mode = "min", default = 1 }, -- near sun cascade at 3/4 resolution
	{ cmd = "r4_sun_smap_scale",    index = 2, value = 0.75, mode = "min", default = 1 }, -- middle sun cascade at 3/4 resolution
	{ cmd = "r4_sun_smap_scale",    index = 3, value = 0.5,  mode = "min", default = 1 }, -- far sun cascade at half resolution
	{ cmd = "r__tf_aniso",                     value = 8,    mode = "min", default = 16 }, -- anisotropic filtering x8
	{ cmd = "ssfx_il_quality",                 value = 16,   mode = "min", default = 32 }, -- indirect light samples
	{ cmd = "lua_parallel_gc_paced",           value = 2,    mode = "max", default = 1 }, -- Lua GC's atomic phase split up (fewer hitches)
}
local deck_preset_section = "deck_preset"

local function console_numbers(s)
	local t = {}
	for n in string.gmatch(s or "", "[-%d%.eE+]+") do
		t[#t + 1] = tonumber(n)
	end
	return t
end

local function deck_preset_value(e, current)
	if e.token then
		return e.token[current] or current
	end
	local nums = console_numbers(current)
	local i = e.index or 1
	if not nums[i] then
		return current
	end
	if e.mode == "max" then
		nums[i] = math.max(nums[i], e.value)
	elseif e.mode == "set" then
		nums[i] = e.value
	else
		nums[i] = math.min(nums[i], e.value)
	end
	if not e.index then
		return tostring(nums[1])
	end
	return table.concat(nums, ", ")
end

function apply_deck_preset()
	local enable = ui_options.get("video/advanced/deck_preset") == true
	local cfg = axr_main.config
	local con = get_console()

	-- A value remembered before (an empty one is none: earlier versions blanked the lines they restored)
	local function remembered(cmd)
		local v = cfg:r_value(deck_preset_section, cmd, 0)
		return v ~= nil and v ~= "" and v or nil
	end

	if enable then
		-- Remember each setting once (a setting listed twice keeps its first, unchanged value)
		for _, e in ipairs(deck_preset) do
			if not remembered(e.cmd) then
				local current = con:get_string(e.cmd)
				if current then
					cfg:w_value(deck_preset_section, e.cmd, current)
				end
			end
		end
		for _, e in ipairs(deck_preset) do
			local current = con:get_string(e.cmd)
			if current then
				exec_console_cmd(e.cmd .. " " .. deck_preset_value(e, current))
			end
		end
	else
		-- The remembered value, once for a setting listed twice; with none, each entry's value to the default
		local done = {}
		for _, e in ipairs(deck_preset) do
			local saved = remembered(e.cmd)
			if saved then
				if not done[e.cmd] then
					exec_console_cmd(e.cmd .. " " .. saved)
				end
			else
				local current = con:get_string(e.cmd)
				if current then
					local value = e.token and e.default or deck_preset_value({ index = e.index, value = e.default, mode = "set" }, current)
					printf("! Steam Deck preset: no value of %s remembered, set to the default: %s", e.cmd, value)
					exec_console_cmd(e.cmd .. " " .. value)
				end
			end
			done[e.cmd] = true
		end
		for cmd in pairs(done) do
			cfg:remove_line(deck_preset_section, cmd)
		end
	end

	cfg:save()
	exec_console_cmd("cfg_save")
end

-- UI entrypoint
function on_xml_read()
	ui_options_base = ui_options.init_opt_base
	ui_options.init_opt_base = function()
		ui_options_base()
		table.insert(ui_options.options, options_modded_exes.GROUP)

		function cont_sound_device()
			local cont = {}
			local devices = get_console():get_token_list("snd_device")
			if devices then
				for i=1,#devices do
					cont[#cont + 1] = {devices[i]}
				end
			end
			if #cont == 0 then
				local curr = get_console_cmd(0, "snd_device")
				cont[1] = {curr}
			end
			return cont
		end

		local v = ui_options.get_opt_table("sound/general/sound_device")
		if v then
			v.restart = false
			v.content = {cont_sound_device}
		end

		-- Extra options in vanilla options (not Modded Exes Options)
		local need_init_opt_coder = false

		-- Monitor selection
		function cont_vid_monitor()
			local cont = {}
			local monitors = get_console():get_token_list("vid_monitor")
			if monitors then
				for i=1,#monitors do
					cont[#cont + 1] = {monitors[i]}
				end
			end
			if #cont == 0 then
				local curr = get_console_cmd(0, "vid_monitor")
				cont[1] = {curr ~= "" and curr or "Auto"}
			end
			return cont
		end

		local basic = nil
		for _, top in ipairs(ui_options.options) do
			if top.id == "video" and top.gr then
				for _, sub in ipairs(top.gr) do
					if sub.id == "basic" then basic = sub; break end
				end
				break
			end
		end
		if basic and basic.gr then
			local already_present = false
			local renderer_idx = nil
			for i, row in ipairs(basic.gr) do
				if row.id == "monitor" then
					already_present = true
					break
				end
				if row.id == "renderer" then
					renderer_idx = i
				end
			end
			if not already_present and renderer_idx then
				table.insert(basic.gr, renderer_idx + 1, {
					id      = "monitor",
					type    = "list",
					val     = 0,
					def     = "Auto",
					cmd     = "vid_monitor",
					content = {cont_vid_monitor},
					no_str  = true,
					restart = true,
				})
				need_init_opt_coder = true
			end
			-- The DX12 exe runs the same R4 renderer ("renderer_r4", shown as DX11): its entry is labelled DX12 there
			local renderer = renderer_idx and basic.gr[renderer_idx]
			local cont_base = renderer and renderer.content and renderer.content[1]
			if type(cont_base) == "function" and get_console():get_string("r__dx12_threaded") then
				renderer.content = {function(...)
					local cont = cont_base(...)
					for _, c in ipairs(cont or {}) do
						if c[1] == "renderer_r4" then c[2] = "renderer_r4_dx12" end
					end
					return cont
				end}
			end
		end

		-- Persistent weather switch
		local weather = nil
		for _, top in ipairs(ui_options.options) do
			if top.id == "video" and top.gr then
				for _, sub in ipairs(top.gr) do
					if sub.id == "weather" then weather = sub; break end
				end
				break
			end
		end
		if weather and weather.gr then
			local already_present = false
			local clear_slide = nil
			for i, row in ipairs(weather.gr) do
				if row.id == "persistent_weather" then
					already_present = true
					break
				end
				if row.id == "clear_slide" then
					clear_slide = i
				end
			end
			if not already_present and clear_slide then
				table.insert(weather.gr, clear_slide, {
					id      = "persistent_weather",
					type    = "check",
					val     = 1,
					def 	= true,
				})
				need_init_opt_coder = true
			end
		end

		-- Upscaling (upscaler, its mode, DLSS preset, FSR sharpness, frame generation) at the end of Video > Basic, next
		-- to the resolution; the performance overlay and the Deck preset below SMAA in Video > Advanced
		local basic, advanced = nil, nil
		for _, top in ipairs(ui_options.options) do
			if top.id == "video" and top.gr then
				for _, sub in ipairs(top.gr) do
					if sub.id == "basic" then basic = sub end
					if sub.id == "advanced" then advanced = sub end
				end
				break
			end
		end
		if basic and basic.gr and advanced and advanced.gr then
			local already_present = false
			local insert_idx = #advanced.gr + 1
			for _, row in ipairs(basic.gr) do
				if row.id == "upscaler" then
					already_present = true
					break
				end
			end
			for i, row in ipairs(advanced.gr) do
				if row.id == "smaa" then
					insert_idx = i + 1
				end
			end
			if not already_present then
				local for_r4 = {ui_options.for_renderer, "renderer_r4"}

				-- Only offer the upscalers this GPU supports ("dlss,fsr,xess", "fsr" or "");
				-- nil when the engine doesn't report it (other renderers, older exes): offer both
				local avail = get_console():get_string("r4_upscaler_available")
				local upscaler_content = {{"off", "upscaler_off"}}
				if not avail or string.find(avail, "dlss", 1, true) then
					table.insert(upscaler_content, {"dlss", "upscaler_dlss"})
				end
				if not avail or string.find(avail, "fsr", 1, true) then
					table.insert(upscaler_content, {"fsr", "upscaler_fsr"})
				end
				-- XeSS only where the engine reports it (the DX12 exe)
				if avail and string.find(avail, "xess", 1, true) then
					table.insert(upscaler_content, {"xess", "upscaler_xess"})
				end
				local rows = {
					{
						id           = "upscaler",
						type         = "list",
						val          = 0,
						cmd          = "r4_upscaler",
						content      = upscaler_content,
						vid          = true,
						precondition = for_r4,
					},
					{
						id           = "upscaler_quality",
						type         = "list",
						val          = 0,
						cmd          = "r4_upscaler_quality",
						content      = {
							{"native", "upscaler_native"},
							{"quality", "upscaler_quality"},
							{"balanced", "upscaler_balanced"},
							{"performance", "upscaler_performance"},
							{"ultra_performance", "upscaler_ultra_performance"},
						},
						vid          = true,
						precondition = for_r4,
					},
					{
						id           = "dlss_preset",
						type         = "list",
						val          = 0,
						cmd          = "r4_dlss_preset",
						content      = {
							{"default", "dlss_preset_default"},
							{"j", "dlss_preset_j"},
							{"k", "dlss_preset_k"},
							{"l", "dlss_preset_l"},
							{"m", "dlss_preset_m"},
						},
						vid          = true,
						precondition = for_r4,
					},
					{
						id           = "fsr_sharpness",
						type         = "track",
						val          = 2,
						cmd          = "r4_fsr_sharpness",
						min          = 0,
						max          = 1,
						step         = 0.05,
						precondition = for_r4,
					},
					{
						id           = "perf_overlay",
						type         = "list",
						val          = 0,
						cmd          = "perf_overlay",
						content      = {{"off", "perf_overlay_off"}, {"compact", "perf_overlay_compact"}, {"graph", "perf_overlay_graph"}, {"detailed", "perf_overlay_detailed"}},
						precondition = for_r4,
					},
					{
						id           = "perf_overlay_pos",
						type         = "list",
						val          = 0,
						cmd          = "perf_overlay_pos",
						content      = {
							{"top_left", "perf_overlay_top_left"},
							{"top_right", "perf_overlay_top_right"},
							{"bottom_left", "perf_overlay_bottom_left"},
							{"bottom_right", "perf_overlay_bottom_right"},
						},
						precondition = for_r4,
					},
					{
						id           = "perf_overlay_mods",
						type         = "list",
						val          = 0,
						cmd          = "perf_overlay_mods",
						content      = {{"0", "perf_overlay_off"}, {"1", "perf_overlay_mods_on"}},
						precondition = for_r4,
					},
					{
						id           = "deck_preset",
						type         = "check",
						val          = 1,
						def          = false,
						functor      = {apply_deck_preset},
						vid          = true, -- shadow and screen space shadow quality need it
						precondition = for_r4,
					},
				}
				-- DLSS preset only where DLSS can run; frame generation only in the DX12 exe (the command exists there).
				-- Rows of commands the running exe doesn't have (an older exe with this script) are left out
				for i = #rows, 1, -1 do
					local row = rows[i]
					if (row.id == "dlss_preset" and avail and not string.find(avail, "dlss", 1, true))
						or (row.cmd and not get_console():get_string(row.cmd)) then
						table.remove(rows, i)
					end
				end
				-- Frame generation (the DX12 exe has the command): one list, off or which one. XeSS's only where the exe
				-- reports XeSS (built with Intel's SDK). After the upscaler's rows, before the overlay's
				if get_console():get_string("r4_framegen") then
					local framegen_content = {{"off", "framegen_off"}, {"fsr", "framegen_fsr"}}
					if avail and string.find(avail, "xess", 1, true) then
						table.insert(framegen_content, {"xess", "framegen_xess"})
					end
					local at = #rows + 1
					for i, row in ipairs(rows) do
						if row.id == "perf_overlay" then
							at = i
							break
						end
					end
					table.insert(rows, at, {
						id           = "framegen",
						type         = "list",
						val          = 0,
						cmd          = "r4_framegen",
						content      = framegen_content,
						vid          = true,
						precondition = for_r4,
					})
				end
				-- HDR output and its brightness (the DX12 exe): after frame generation
				if get_console():get_string("r__dx12_threaded") and get_console():get_string("r4_hdr_output") then
					local at = #rows + 1
					for i, row in ipairs(rows) do
						if row.id == "perf_overlay" then
							at = i
							break
						end
					end
					table.insert(rows, at, {
						id           = "hdr_output",
						type         = "list",
						val          = 0,
						cmd          = "r4_hdr_output",
						content      = {{"0", "hdr_output_off"}, {"1", "hdr_output_on"}},
						vid          = true,
						precondition = for_r4,
					})
					table.insert(rows, at + 1, {
						id           = "hdr_brightness",
						type         = "track",
						val          = 2,
						cmd          = "r4_hdr_paper_white",
						min          = 80,
						max          = 500,
						step         = 10,
						precondition = for_r4,
					})
				end
				local in_basic = {upscaler = true, upscaler_quality = true, dlss_preset = true, fsr_sharpness = true, framegen = true,
					hdr_output = true, hdr_brightness = true}
				-- Before GAMMA's lighting button, the page's last row: its row is shorter than the button, the next row
				-- drawn over it
				local basic_idx = #basic.gr + 1
				for i, row in ipairs(basic.gr) do
					if row.id == "lighting" then
						basic_idx = i
					end
				end
				for _, row in ipairs(rows) do
					if in_basic[row.id] then
						table.insert(basic.gr, basic_idx, row)
						basic_idx = basic_idx + 1
					else
						table.insert(advanced.gr, insert_idx, row)
						insert_idx = insert_idx + 1
					end
				end
				need_init_opt_coder = true
			end
		end

		if need_init_opt_coder and ui_options.init_opt_coder then
			ui_options.init_opt_coder()
		end
	end
	ui_options.init_opt_base()
end
